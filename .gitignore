# Credentials — never commit real keys
.env
.env.local

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Dashboard dependencies and generated frontend build output
docs/dashboard/node_modules/
docs/dashboard/dist/

# Working/scratch outputs — noncanonical, regenerable, or relay-bundle staging.
# Durable artifacts (evidence layer, ledger, audit docs) belong in docs/analysis/,
# not here. See docs/analysis/repo_cleanup_audit_2026-07-14.md for the retention
# policy this formalizes.
tmp/

# Resumable live-scout checkpoints duplicate finalized candidate registries and
# redacted request metadata; keep them local and out of durable analysis commits.
docs/analysis/compensation_extraction/TARGETED-SCOUTING-FOUR-LANE-FIXED-STAGGER-LIVE-RUN-OVERLAP-AUTHORIZED-2026-07-25/checkpoints/

# Corpus full-text storage — UNCOMMENT to keep documents out of git (Option A).
# Licensed Westlaw/Lexis/Factiva pulls should NOT be committed to a shared remote.
# corpus/

# Keep the corpus/ folder tracked even if empty
!corpus/.gitkeep

# Retained/downloaded source binaries are local or external artifacts, not normal
# Git content. Git tracks their manifests, hashes, lineage, summaries, and storage
# pointers instead. See future_artifact_storage_standard_for_retained_sources.md.
/artifacts/local_retained_sources/
/artifacts/local_extracted_text/
/docs/analysis/compensation_extraction/*/retained_sources/

# BROAD-STATE 4x2500 span worker ledgers are resumable local intermediates.
# Their locked queues, merged source results, merged bounded candidates,
# checkpoints, and summaries are durable at the task root; do not duplicate the
# large lane-local append-only CSV payloads in Git.
/docs/analysis/compensation_extraction/BROAD-STATE-4X2500-SPAN-EXTRACTION-2026-07-30/lanes/*/source_results.csv
/docs/analysis/compensation_extraction/BROAD-STATE-4X2500-SPAN-EXTRACTION-2026-07-30/lanes/*/span_candidates.csv
