{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_format": {
      "minLength": 1,
      "type": "string"
    },
    "canonical_source_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "canonical_source_count": {
      "minimum": 0,
      "type": "integer"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "library_name": {
      "minLength": 1,
      "type": "string"
    },
    "library_version": {
      "minLength": 1,
      "type": "string"
    },
    "manifest_paths": {
      "additionalProperties": {
        "description": "POSIX path relative to the source-library root.",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "original_volume_count": {
      "minimum": 0,
      "type": "integer"
    },
    "source_only_boundary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "analytical_results": {
          "const": false
        },
        "extracted_text_companions": {
          "type": "boolean"
        },
        "original_sources": {
          "const": true
        },
        "report_material": {
          "const": false
        },
        "source_metadata": {
          "const": true
        }
      },
      "required": [
        "original_sources",
        "source_metadata",
        "extracted_text_companions",
        "analytical_results",
        "report_material"
      ],
      "title": "Source-only boundary",
      "type": "object"
    },
    "text_volume_count": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "library_name",
    "library_version",
    "created_at_utc",
    "hash_algorithm",
    "archive_format",
    "canonical_source_count",
    "canonical_source_bytes",
    "original_volume_count",
    "text_volume_count",
    "manifest_paths",
    "source_only_boundary"
  ],
  "title": "Source library manifest",
  "type": "object"
}
