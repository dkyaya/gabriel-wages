{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gabriel Wages source index record",
  "type": "object",
  "required": ["source_id", "title", "safe_title", "source_family", "file_extension", "MIME_type", "archive_relative_path", "source_SHA256", "source_size_bytes", "availability_status", "source_volume_id"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "title": {"type": "string"},
    "safe_title": {"type": "string"},
    "source_family": {"type": "string"},
    "file_extension": {"type": "string"},
    "MIME_type": {"type": "string"},
    "municipality": {"type": "string"},
    "state": {"type": "string"},
    "county_if_available": {"type": "string"},
    "primary_geography_type": {"type": "string"},
    "period_label": {"type": "string"},
    "period_start_if_available": {"type": "string"},
    "period_end_if_available": {"type": "string"},
    "original_URL": {"type": "string"},
    "archive_relative_path": {"type": "string", "pattern": "^sources/"},
    "source_SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_size_bytes": {"type": "string", "pattern": "^[0-9]+$"},
    "alias_count": {"type": "string"},
    "provenance_count": {"type": "string"},
    "extracted_text_available": {"enum": ["true", "false"]},
    "extracted_text_relative_path": {"type": "string"},
    "extraction_status": {"type": "string"},
    "OCR_status": {"type": "string"},
    "known_issue": {"type": "string"},
    "availability_status": {"type": "string"},
    "redistribution_note": {"type": "string"},
    "source_volume_id": {"type": "string", "pattern": "^VOL-[0-9]{3}$"}
  },
  "additionalProperties": false
}
